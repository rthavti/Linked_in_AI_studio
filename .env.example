APP_NAME=LinkedIn AI Studio

HOST=127.0.0.1
PORT=8000

LOG_LEVEL=INFO

DATABASE_URL=sqlite:///data/linkedin_ai.db

OPENAI_API_KEY=your-openai-api-key

OPENAI_BASE_URL=https://api.openai.com/v1

GPT_MODEL=gpt-5.5

GPT_TEMPERATURE=0.7

GPT_MAX_TOKENS=600

IMAGE_PROVIDER=openai

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/publish/callback
LINKEDIN_SCOPES=w_member_social openid profile
LINKEDIN_TOKEN_SECRET=your-linkedin-token-secret
LINKEDIN_OAUTH_STATE_TTL_SECONDS=600
PUBLISH_RETRY_DELAY_SECONDS=300

POST_TIME=10:00

TIMEZONE=Asia/Kolkata
